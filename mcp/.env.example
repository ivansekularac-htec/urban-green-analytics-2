# MCP
MCP_HOST=0.0.0.0
MCP_PORT=8001

# ClickHouse - use localhost when running the service outside Docker;
# the container name only resolves inside the compose network.
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_DB=urbangreen_dw
CLICKHOUSE_USER=urbangreen
CLICKHOUSE_PASSWORD=

# Per-query guardrails
CLICKHOUSE_CONNECT_TIMEOUT=10
CLICKHOUSE_QUERY_TIMEOUT=30
CLICKHOUSE_MAX_MEMORY_USAGE=1000000000
