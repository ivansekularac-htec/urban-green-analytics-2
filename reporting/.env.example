# REPORTING
REPORTING_LOG_LEVEL=INFO
REPORTING_EMAIL_FROM=reports@urbangreen.local
REPORTING_EMAIL_TO=executives@urbangreen.local

# ClickHouse - use localhost when running the service outside Docker;
# the container name only resolves inside the compose network.
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_DB=urbangreen_dw
CLICKHOUSE_USER=urbangreen
CLICKHOUSE_PASSWORD=

# Ollama
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:2b

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_STAGING_BUCKET=staging
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=

# Mailpit SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
