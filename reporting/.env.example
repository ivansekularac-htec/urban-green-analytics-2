# REPORTING
REPORTING_HOST=0.0.0.0
REPORTING_PORT=8002
REPORTING_LOG_LEVEL=INFO

# Report shape
REPORTING_TOP_FARMS=3
REPORTING_MAX_INSIGHTS=4
REPORTING_NARRATIVE_MAX_CHARS=1200
REPORTING_QUERY_TIMEOUT_SECONDS=30

# Local model policy
REPORTING_LLM_TIMEOUT_SECONDS=120
REPORTING_LLM_NUM_PREDICT=400
REPORTING_LLM_TEMPERATURE=0.2
REPORTING_LLM_KEEP_ALIVE=10m

# Publishing
REPORTING_PUBLISH_S3=true
REPORTING_PUBLISH_EMAIL=true
REPORTING_S3_PREFIX=reports/executive
REPORTING_EMAIL_FROM=reports@urbangreen.local
REPORTING_EMAIL_TO=executives@urbangreen.local

# ClickHouse - use localhost when running the service outside Docker;
# the container name only resolves inside the compose network.
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_DB=urbangreen_dw
CLICKHOUSE_USER=urbangreen
CLICKHOUSE_PASSWORD=

# Ollama
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:2b

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_STAGING_BUCKET=staging
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=

# Mailpit SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
