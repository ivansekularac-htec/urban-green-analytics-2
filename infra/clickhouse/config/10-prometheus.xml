<clickhouse>
    <!-- ClickHouse's built-in Prometheus exporter for the observability stack.
         It publishes all three metric groups so dashboards can plot internal
         counters, gauges and async system stats.

         The port MUST be its own (9363, the standard CH exporter port) and NOT
         8123. ClickHouse spawns a separate listener for the <prometheus> block;
         pointing it at 8123 collides with the HTTP interface and stalls the
         server in "starting" forever - the symptom is config merges in the log
         with no "Ready for connections", and TCP 9000 also refusing. -->
    <prometheus>
        <endpoint>/metrics</endpoint>
        <port>9363</port>
        <metrics>true</metrics>
        <events>true</events>
        <asynchronous_metrics>true</asynchronous_metrics>
    </prometheus>
</clickhouse>
