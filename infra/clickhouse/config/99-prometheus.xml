<clickhouse>
    <!--
        Keep Prometheus on its dedicated listener port.

        Do not reuse ClickHouse HTTP port 8123 here. The Prometheus endpoint
        uses a separate listener, so reusing 8123 would collide with the main
        HTTP interface and can prevent ClickHouse from reaching the ready state.
    -->
    <prometheus>
        <endpoint>/metrics</endpoint>
        <port>9363</port>
        <metrics>true</metrics>
        <events>true</events>
        <asynchronous_metrics>true</asynchronous_metrics>
    </prometheus>
</clickhouse>