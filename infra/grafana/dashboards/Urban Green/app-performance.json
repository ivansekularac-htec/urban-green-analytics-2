        {
            "id": 8,
            "type": "timeseries",
            "title": "p95 Tool Latency by Tool",
            "description": "histogram_quantile(0.95, ...) over mcp_tool_duration_seconds, per tool.",
            "gridPos": {
                "x": 0,
