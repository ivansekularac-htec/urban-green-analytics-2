        "from": "now-6h",
        "to": "now"
    },
    "templating": {
        "list": []
    },
    "annotations": {
        "list": []
    },
    "links": [],
    "panels": [
        {
            "id": 1,
            "type": "row",
            "title": "FastAPI",
            "collapsed": false,
            "gridPos": {
                "x": 0,
                "y": 0,
                "w": 24,
                "h": 1
            },
            "panels": []
        },
        {
            "id": 2,
            "type": "stat",
            "title": "Request Rate",
            "description": "Current FastAPI request rate across all handlers.",
            "gridPos": {
                "x": 0,
                "y": 1,
                "w": 8,
                "h": 4
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "sum(rate(http_requests_total[$__rate_interval])) or vector(0)",
                    "instant": true
                }
            ],
            "options": {
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "colorMode": "background",
                "graphMode": "none",
                "textMode": "value",
                "justifyMode": "center"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps",
                    "min": 0,
                    "noValue": "0",
                    "decimals": 2,
                    "color": {
                        "mode": "fixed",
                        "fixedColor": "#89BDB0"
                    }
                },
                "overrides": []
            }
        },
        {
            "id": 3,
            "type": "stat",
            "title": "Total Requests (selected range)",
            "description": "Total FastAPI requests during the selected time range.",
            "gridPos": {
                "x": 0,
                "y": 5,
                "w": 8,
                "h": 6
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "sum(increase(http_requests_total[$__range])) or vector(0)",
                    "instant": true
                }
            ],
            "options": {
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "colorMode": "background",
                "graphMode": "none",
                "textMode": "value",
                "justifyMode": "center"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "min": 0,
                    "noValue": "0",
                    "decimals": 2,
                    "color": {
                        "mode": "fixed",
                        "fixedColor": "#B7D3C0"
                    }
                },
                "overrides": []
            }
        },
        {
            "id": 4,
            "type": "stat",
            "title": "p95 Latency",
            "description": "Global FastAPI p95 latency from the high-resolution histogram. SLA is 1.5 s.",
            "gridPos": {
                "x": 8,
                "y": 1,
                "w": 8,
                "h": 4
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_highr_seconds_bucket[$__rate_interval])))",
                    "instant": true
                }
            ],
            "options": {
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "colorMode": "background",
                "graphMode": "none",
                "textMode": "value",
                "justifyMode": "center"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "s",
                    "min": 0,
                    "noValue": "0",
                    "decimals": 3,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "value": null,
                                "color": "#4CBB8A"
                            },
                            {
                                "value": 1.0,
                                "color": "#5FAF72"
                            },
                            {
                                "value": 1.5,
                                "color": "#28594F"
                            }
                        ]
                    }
                },
                "overrides": []
            }
        },
        {
            "id": 5,
            "type": "stat",
            "title": "Error Ratio",
            "description": "Combined 4xx and 5xx request ratio across FastAPI. 0 means no request errors in the rate window.",
            "gridPos": {
                "x": 16,
                "y": 1,
                "w": 8,
                "h": 4
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "((sum(rate(http_requests_total{status=~\"4xx|5xx\"}[$__rate_interval])) or vector(0)) / clamp_min((sum(rate(http_requests_total[$__rate_interval])) or vector(0)), 0.000001))",
                    "instant": true
                }
            ],
            "options": {
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "colorMode": "background",
                "graphMode": "none",
                "textMode": "value",
                "justifyMode": "center"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "percentunit",
                    "min": 0,
                    "noValue": "0",
                    "decimals": 2,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "value": null,
                                "color": "#4CBB8A"
                            },
                            {
                                "value": 0.01,
                                "color": "#5C9E8A"
                            },
                            {
                                "value": 0.05,
                                "color": "#28594F"
                            }
                        ]
                    }
                },
                "overrides": []
            }
        },
        {
            "id": 6,
            "type": "bargauge",
            "title": "Request Rate by Route",
            "description": "Current FastAPI request rate grouped by the instrumentator handler label.",
            "gridPos": {
                "x": 8,
                "y": 5,
                "w": 16,
                "h": 6
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "sort_desc(sum by (handler) (rate(http_requests_total{handler!=\"none\"}[$__rate_interval])) > 0)",
                    "legendFormat": "{{handler}}",
                    "instant": true
                }
            ],
            "options": {
                "orientation": "horizontal",
                "displayMode": "basic",
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "showUnfilled": true
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps",
                    "min": 0,
                    "noValue": "0",
                    "color": {
                        "mode": "fixed",
                        "fixedColor": "#89BDB0"
                    }
                },
                "overrides": []
            }
        },
        {
            "id": 7,
            "type": "timeseries",
            "title": "API Latency Percentiles",
            "description": "Global p50, p95 and p99 FastAPI latency from the high-resolution histogram. The 1.5 s threshold is the application SLA reference.",
            "gridPos": {
                "x": 0,
                "y": 11,
                "w": 24,
                "h": 8
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "refId": "A",
                    "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_highr_seconds_bucket[$__rate_interval])))",
                    "legendFormat": "p50"
                },
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "refId": "B",
                    "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_highr_seconds_bucket[$__rate_interval])))",
                    "legendFormat": "p95"
                },
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "refId": "C",
                    "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_highr_seconds_bucket[$__rate_interval])))",
                    "legendFormat": "p99"
                },
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "refId": "D",
                    "expr": "vector(1.5)",
                    "legendFormat": "SLA 1.5s"
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "right",
                    "width": 220,
                    "calcs": [
                        "max"
                    ],
                    "sortBy": "Max",
                    "sortDesc": true
                },
                "tooltip": {
                    "mode": "multi"
                }
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "s",
                    "min": 0,
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 2,
                        "fillOpacity": 12,
                        "showPoints": "never",
                        "spanNulls": false,
                        "stacking": {
                            "mode": "none",
                            "group": "A"
                        },
                        "thresholdsStyle": {
                            "mode": "line"
                        }
                    },
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "value": null,
                                "color": "#4CBB8A"
                            },
                            {
                                "value": 1.5,
                                "color": "#757575"
                            }
                        ]
                    }
                },
                "overrides": [
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "p50"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "mode": "fixed",
                                    "fixedColor": "#6BAF92"
                                }
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "p95"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "mode": "fixed",
                                    "fixedColor": "#1F7A8C"
                                }
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "p99"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "mode": "fixed",
                                    "fixedColor": "#28594F"
                                }
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "SLA 1.5s"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "mode": "fixed",
                                    "fixedColor": "#757575"
                                }
                            },
                            {
                                "id": "custom.fillOpacity",
                                "value": 0
                            },
                            {
                                "id": "custom.lineWidth",
                                "value": 2
                            },
                            {
                                "id": "custom.lineStyle",
                                "value": {
                                    "fill": "dash",
                                    "dash": [
                                        10,
                                        10
                                    ]
                                }
                            }
                        ]
                    }
                ]
            }
        },
