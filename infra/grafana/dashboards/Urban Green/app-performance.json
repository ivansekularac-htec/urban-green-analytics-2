{
    "uid": "app-performance",
    "title": "App Performance",
    "description": "FastAPI request performance and MCP tool/AI-generated SQL observability in one operator view.",
    "tags": [
        "urbangreen",
        "observability"
    ],
    "timezone": "browser",
    "editable": false,
    "graphTooltip": 1,
    "schemaVersion": 39,
    "version": 1,
    "refresh": "30s",
    "time": {
        "from": "now-6h",
        "to": "now"
    },
    "templating": {
        "list": []
    },
    "annotations": {
        "list": []
    },
    "links": [],
    "panels": [
        {
            "id": 0,
            "type": "row",
            "title": "FastAPI",
            "description": "Request throughput, latency percentiles, and HTTP error rates for the Urban Green API.",
            "collapsed": false,
            "gridPos": {
                "x": 0,
                "y": 0,
                "w": 24,
                "h": 1
            },
            "panels": []
        },
        {
            "id": 1,
            "type": "timeseries",
            "title": "Request Rate by Route",
            "description": "Requests per second by the instrumentator's normalized handler label. The handler label represents the FastAPI route template.",
            "gridPos": {
                "x": 0,
                "y": 1,
                "w": 8,
                "h": 8
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "sum by (handler) (rate(http_requests_total{job=\"urbangreen-api\"}[$__rate_interval]))",
                    "legendFormat": "{{handler}}",
                    "instant": false,
                    "range": true
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "right",
                    "width": 220,
                    "calcs": [
                        "max"
                    ],
                    "sortBy": "Max",
                    "sortDesc": true
                },
                "tooltip": {
                    "mode": "multi"
                }
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps",
                    "min": 0,
                    "custom": {
                        "drawStyle": "line",
                        "fillOpacity": 20,
                        "lineWidth": 2,
                        "showPoints": "never",
                        "stacking": {
                            "mode": "none"
                        }
                    }
                },
                "overrides": []
            }
        },
        {
            "id": 2,
            "type": "timeseries",
            "title": "Request Latency Percentiles",
            "description": "Overall p50, p95, and p99 request latency. The red reference line marks the 1.5 second SLA.",
            "gridPos": {
                "x": 8,
                "y": 1,
                "w": 8,
                "h": 8
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_highr_seconds_bucket{job=\"urbangreen-api\"}[$__rate_interval])))",
                    "legendFormat": "p50",
                    "instant": false,
                    "range": true
                },
                {
                    "refId": "B",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_highr_seconds_bucket{job=\"urbangreen-api\"}[$__rate_interval])))",
                    "legendFormat": "p95",
                    "instant": false,
                    "range": true
                },
                {
                    "refId": "C",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_highr_seconds_bucket{job=\"urbangreen-api\"}[$__rate_interval])))",
                    "legendFormat": "p99",
                    "instant": false,
                    "range": true
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "right",
                    "width": 160,
                    "calcs": [
                        "max"
                    ],
                    "sortBy": "Max",
                    "sortDesc": true
                },
                "tooltip": {
                    "mode": "multi"
                }
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "s",
                    "min": 0,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "value": null,
                                "color": "#4CBB8A"
                            },
                            {
                                "value": 1.5,
                                "color": "red"
                            }
                        ]
                    },
                    "custom": {
                        "drawStyle": "line",
                        "fillOpacity": 12,
                        "lineWidth": 2,
                        "showPoints": "never",
                        "stacking": {
                            "mode": "none"
                        },
                        "thresholdsStyle": {
                            "mode": "line"
                        }
                    }
                },
                "overrides": [
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "p50"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "mode": "fixed",
                                    "fixedColor": "#4CBB8A"
                                }
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "p99"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "mode": "fixed",
                                    "fixedColor": "#28594F"
                                }
                            }
                        ]
                    }
                ]
            }
        },
        {
            "id": 3,
            "type": "timeseries",
            "title": "4xx / 5xx Error Rates",
            "description": "HTTP errors per second. The status label is bucketed by the instrumentator, so these queries use status=\"4xx\" and status=\"5xx\", not raw HTTP codes.",
            "gridPos": {
                "x": 16,
                "y": 1,
                "w": 8,
                "h": 8
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "sum(rate(http_requests_total{job=\"urbangreen-api\",status=\"4xx\"}[$__rate_interval])) or vector(0)",
                    "legendFormat": "4xx",
                    "instant": false,
                    "range": true
                },
                {
                    "refId": "B",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "sum(rate(http_requests_total{job=\"urbangreen-api\",status=\"5xx\"}[$__rate_interval])) or vector(0)",
                    "legendFormat": "5xx",
                    "instant": false,
                    "range": true
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "right",
                    "width": 140,
                    "calcs": [
                        "max"
                    ],
                    "sortBy": "Max",
                    "sortDesc": true
                },
                "tooltip": {
                    "mode": "multi"
                }
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps",
                    "min": 0,
                    "custom": {
                        "drawStyle": "bars",
                        "fillOpacity": 60,
                        "lineWidth": 1,
                        "showPoints": "never",
                        "stacking": {
                            "mode": "normal"
                        }
                    }
                },
                "overrides": [
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "5xx"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "mode": "fixed",
                                    "fixedColor": "#28594F"
                                }
                            }
                        ]
                    }
                ]
            }
        },
        {
            "id": 4,
            "type": "row",
            "title": "MCP server (AI-generated SQL)",
            "description": "Tool throughput, latency, errors, and the SQL sent by the MCP server to ClickHouse.",
            "collapsed": false,
            "gridPos": {
                "x": 0,
                "y": 9,
                "w": 24,
                "h": 1
            },
            "panels": []
        },
        {
            "id": 5,
            "type": "timeseries",
            "title": "Tool Call Rate by Tool",
            "description": "Completed MCP tool calls per second, grouped by the emitted tool label and summed across outcomes.",
            "gridPos": {
                "x": 0,
                "y": 10,
                "w": 8,
                "h": 8
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "sum by (tool) (rate(mcp_tool_calls_total{job=\"urbangreen-mcp\"}[$__rate_interval]))",
                    "legendFormat": "{{tool}}",
                    "instant": false,
                    "range": true
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "right",
                    "width": 200,
                    "calcs": [
                        "max"
                    ],
                    "sortBy": "Max",
                    "sortDesc": true
                },
                "tooltip": {
                    "mode": "multi"
                }
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps",
                    "min": 0,
                    "custom": {
                        "drawStyle": "line",
                        "fillOpacity": 20,
                        "lineWidth": 2,
                        "showPoints": "never",
                        "stacking": {
                            "mode": "none"
                        }
                    }
                },
                "overrides": []
            }
        },
        {
            "id": 6,
            "type": "timeseries",
            "title": "p95 Tool Latency",
            "description": "95th percentile wall-clock duration of completed MCP tool calls, grouped by tool.",
            "gridPos": {
                "x": 8,
                "y": 10,
                "w": 8,
                "h": 8
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "histogram_quantile(0.95, sum by (le, tool) (rate(mcp_tool_duration_seconds_bucket{job=\"urbangreen-mcp\"}[$__rate_interval])))",
                    "legendFormat": "{{tool}}",
                    "instant": false,
                    "range": true
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "right",
                    "width": 200,
                    "calcs": [
                        "max"
                    ],
                    "sortBy": "Max",
                    "sortDesc": true
                },
                "tooltip": {
                    "mode": "multi"
                }
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "s",
                    "min": 0,
                    "custom": {
                        "drawStyle": "line",
                        "fillOpacity": 20,
                        "lineWidth": 2,
                        "showPoints": "never",
                        "stacking": {
                            "mode": "none"
                        }
                    },
                    "color": {
                        "mode": "palette-classic"
                    }
                },
                "overrides": []
            }
        },
        {
            "id": 7,
            "type": "gauge",
            "title": "Tool Error Ratio (5m)",
            "description": "Calls with outcome=\"error\" divided by all MCP tool calls over five minutes. The denominator is clamped to avoid NaN at zero or very low traffic.",
            "gridPos": {
                "x": 16,
                "y": 10,
                "w": 8,
                "h": 8
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "(sum(increase(mcp_tool_calls_total{job=\"urbangreen-mcp\",outcome=\"error\"}[5m])) or vector(0)) / clamp_min((sum(increase(mcp_tool_calls_total{job=\"urbangreen-mcp\"}[5m])) or vector(0)), 1)",
                    "instant": true,
                    "range": false
                }
            ],
            "options": {
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "orientation": "auto",
                "showThresholdLabels": false,
                "showThresholdMarkers": true
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "percentunit",
                    "min": 0,
                    "max": 1,
                    "noValue": "0%",
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "value": null,
                                "color": "#4CBB8A"
                            },
                            {
                                "value": 0.01,
                                "color": "yellow"
                            },
                            {
                                "value": 0.05,
                                "color": "red"
                            }
                        ]
                    }
                },
                "overrides": []
            }
        },
        {
            "id": 8,
            "type": "logs",
            "title": "AI-generated SQL Queries",
            "description": "The safety-rewritten SQL actually sent by the MCP execute_query tool to ClickHouse, including successful and failed execution attempts.",
            "gridPos": {
                "x": 0,
                "y": 18,
                "w": 24,
                "h": 10
            },
            "datasource": {
                "type": "loki",
                "uid": "loki"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "loki",
                        "uid": "loki"
                    },
                    "expr": "{service=\"urbangreen-mcp\"} |= \"mcp_sql_executed\"",
                    "queryType": "range",
                    "direction": "backward"
                }
            ],
            "options": {
                "dedupStrategy": "none",
                "enableLogDetails": true,
                "prettifyLogMessage": false,
                "showCommonLabels": false,
                "showLabels": false,
                "showTime": true,
                "sortOrder": "Descending",
                "wrapLogMessage": true
            },
            "fieldConfig": {
                "defaults": {},
                "overrides": []
            }
        }
    ]
}
