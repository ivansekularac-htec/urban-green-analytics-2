        {
            "id": 9,
            "type": "bargauge",
            "title": "Average Latency by Route",
            "description": "Average FastAPI latency by handler. This uses duration sum/count because the per-handler histogram is intentionally low-resolution.",
            "gridPos": {
                "x": 12,
                "y": 19,
                "w": 12,
                "h": 7
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "sort_desc(\n  (\n    sum by (handler) (rate(http_request_duration_seconds_sum{handler!=\"none\"}[$__rate_interval]))\n    /\n    clamp_min(\n      sum by (handler) (rate(http_request_duration_seconds_count{handler!=\"none\"}[$__rate_interval])),\n      0.000001\n    )\n  ) > 0\n)",
                    "legendFormat": "{{handler}}",
                    "instant": true
                }
            ],
            "options": {
                "orientation": "horizontal",
                "displayMode": "basic",
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "showUnfilled": true
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "s",
                    "min": 0,
                    "noValue": "0",
                    "color": {
                        "mode": "fixed",
                        "fixedColor": "#1F7A8C"
                    }
                },
                "overrides": []
            }
        },
