                },
                "overrides": []
            }
        },
        {
            "id": 43,
            "type": "timeseries",
            "title": "S3 traffic in / out",
            "description": "Bytes received (writes into the lake) vs bytes sent (reads from the lake).",
            "gridPos": {
                "x": 15,
                "y": 39,
                "w": 9,
                "h": 8
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "sum(rate(minio_s3_traffic_received_bytes[$__rate_interval]))",
                    "legendFormat": "received"
                },
                {
                    "refId": "B",
