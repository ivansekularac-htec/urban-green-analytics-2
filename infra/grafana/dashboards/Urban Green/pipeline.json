{
    "uid": "pipeline",
    "title": "Pipeline",
    "description": "Kafka consumer lag and topic offset growth, Spark cluster and Structured Streaming activity, and Airflow task outcomes derived from Loki logs. Streaming scheduling delay is shown as a trigger-overrun estimate.",
    "tags": [
        "urbangreen",
        "observability",
        "pipeline"
    ],
    "timezone": "browser",
    "editable": false,
    "graphTooltip": 1,
    "schemaVersion": 39,
    "version": 3,
    "refresh": "30s",
    "time": {
        "from": "now-6h",
        "to": "now"
    },
    "templating": {
        "list": [
            {
                "name": "trigger_interval_ms",
                "type": "textbox",
                "label": "Trigger interval (ms)",
                "description": "Positive numeric trigger interval in milliseconds for the scheduling overrun estimate. Match STREAM_TRIGGER_INTERVAL; the streaming job defaults to 60 seconds (60000 ms).",
                "query": "60000",
                "current": {
                    "selected": true,
                    "text": "60000",
                    "value": "60000"
                },
                "hide": 0
            }
        ]
    },
    "annotations": {
        "list": []
    },
    "links": [],
    "panels": [
        {
            "id": 1,
            "type": "row",
            "title": "Kafka",
            "collapsed": false,
            "gridPos": {
                "x": 0,
                "y": 0,
                "w": 24,
                "h": 1
            },
            "panels": []
        },
        {
            "id": 2,
            "type": "timeseries",
            "title": "Consumer Lag by Group / Topic",
            "description": "Unconsumed records, summed over partitions for each consumer group and topic. After each successful micro-batch, the streaming driver mirrors its completed offsets to the monitoring-only urbangreen-spark-streaming group so kafka-exporter can report real pipeline lag. Spark's MinIO checkpoint remains authoritative for recovery. Missing exporter data is not shown as zero.",
            "gridPos": {
                "x": 0,
                "y": 1,
                "w": 12,
                "h": 8
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "sum by (consumergroup, topic) (kafka_consumergroup_lag{job=\"urbangreen-kafka-exporter\"})",
                    "legendFormat": "{{consumergroup}} / {{topic}}",
                    "instant": false,
                    "range": true
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "bottom",
                    "calcs": [
                        "lastNotNull",
                        "max"
                    ]
                },
                "tooltip": {
                    "mode": "multi"
                }
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "min": 0,
                    "noValue": "NO DATA",
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 2,
                        "fillOpacity": 10,
                        "spanNulls": false,
                        "stacking": {
                            "mode": "none"
                        }
                    }
                },
                "overrides": []
            }
        },
        {
            "id": 3,
            "type": "timeseries",
            "title": "Topic Offset Growth",
            "description": "Growth of each topic's latest offsets in records per second, summed over partitions. Latest offsets are gauges, so deriv is used instead of counter-only increase. Negative slopes after a topic reset are clamped to zero. Requires at least two samples.",
            "gridPos": {
                "x": 12,
                "y": 1,
                "w": 12,
                "h": 8
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "sum by (topic) (clamp_min(deriv(kafka_topic_partition_current_offset{job=\"urbangreen-kafka-exporter\"}[$__rate_interval]), 0))",
                    "legendFormat": "{{topic}}",
                    "instant": false,
                    "range": true
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "bottom",
                    "calcs": [
                        "lastNotNull",
                        "max"
                    ]
                },
                "tooltip": {
                    "mode": "multi"
                }
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "recps",
                    "min": 0,
                    "noValue": "NO DATA",
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 2,
                        "fillOpacity": 10,
                        "spanNulls": false,
                        "stacking": {
                            "mode": "none"
                        }
                    }
                },
                "overrides": []
            }
        },
