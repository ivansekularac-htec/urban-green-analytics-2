        {
            "id": 9,
            "type": "timeseries",
            "title": "Streaming Batch Processing Time",
            "description": "Duration in milliseconds of the latest completed Structured Streaming trigger (durationMs.triggerExecution). This includes the entire micro-batch, rather than only executor processing. Enabled by spark.sql.streaming.metricsEnabled; exposed by PrometheusServlet. The last batch value remains visible between batches.",
            "gridPos": {
                "x": 0,
                "y": 14,
                "w": 12,
                "h": 8
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "{__name__=~\"metrics_.*_driver_spark_streaming_.*_latency_Value\",job=\"urbangreen-spark-streaming\"}",
                    "legendFormat": "Latest batch",
                    "instant": false,
                    "range": true
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "bottom",
                    "calcs": [
                        "lastNotNull",
                        "max"
                    ]
                },
                "tooltip": {
                    "mode": "multi"
                }
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "ms",
                    "min": 0,
                    "noValue": "NO DATA",
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 2,
                        "fillOpacity": 10,
                        "spanNulls": false,
                        "stacking": {
                            "mode": "none"
                        }
                    }
                },
                "overrides": []
            }
        },
        {
            "id": 10,
            "type": "timeseries",
            "title": "Scheduling Delay Estimate (Trigger Overrun)",
            "description": "Estimate only: max(latest completed trigger duration - configured trigger interval, 0), in milliseconds. This is not a measured scheduler delay; Spark 4.0.2 Structured Streaming does not expose a separate scheduling-delay gauge. The Trigger interval (ms) dashboard input defaults to 60000, matching sensor_readings_stream.py's 60-second default. Update this input to match STREAM_TRIGGER_INTERVAL whenever that setting changes. warehouse_load is a separate batch DAG and does not produce these streaming measurements.",
            "gridPos": {
                "x": 12,
                "y": 14,
                "w": 12,
                "h": 8
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "clamp_min({__name__=~\"metrics_.*_driver_spark_streaming_.*_latency_Value\",job=\"urbangreen-spark-streaming\"} - ${trigger_interval_ms:raw}, 0)",
                    "legendFormat": "Estimated overrun",
                    "instant": false,
                    "range": true
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "bottom",
                    "calcs": [
                        "lastNotNull",
                        "max"
                    ]
                },
                "tooltip": {
                    "mode": "multi"
                }
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "ms",
                    "min": 0,
                    "noValue": "NO DATA",
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 2,
                        "fillOpacity": 10,
                        "spanNulls": false,
                        "stacking": {
                            "mode": "none"
                        }
                    }
                },
                "overrides": []
            }
        },
        {
            "id": 11,
            "type": "timeseries",
            "title": "Streaming Input / Processing Rate",
            "description": "Input and processing rates of the latest completed streaming batch, exposed by the Structured Streaming metrics source. Metric names include the application ID and query UUID, so queries match the stable suffix. Value is selected once; the duplicate Number gauge is excluded.",
            "gridPos": {
                "x": 0,
                "y": 22,
                "w": 12,
                "h": 8
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "{__name__=~\"metrics_.*_driver_spark_streaming_.*_inputRate_total_Value\",job=\"urbangreen-spark-streaming\"}",
                    "legendFormat": "Input",
                    "instant": false,
                    "range": true
                },
                {
                    "refId": "B",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "{__name__=~\"metrics_.*_driver_spark_streaming_.*_processingRate_total_Value\",job=\"urbangreen-spark-streaming\"}",
                    "legendFormat": "Processing",
                    "instant": false,
                    "range": true
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "bottom",
                    "calcs": [
                        "lastNotNull",
                        "max"
                    ]
                },
                "tooltip": {
                    "mode": "multi"
                }
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "recps",
                    "min": 0,
                    "noValue": "NO DATA",
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 2,
                        "fillOpacity": 10,
                        "spanNulls": false,
                        "stacking": {
                            "mode": "none"
                        }
                    }
                },
                "overrides": [
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "Input"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "mode": "fixed",
                                    "fixedColor": "#89BDB0"
                                }
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "Processing"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "mode": "fixed",
                                    "fixedColor": "#4CBB8A"
                                }
                            }
                        ]
                    }
                ]
            }
