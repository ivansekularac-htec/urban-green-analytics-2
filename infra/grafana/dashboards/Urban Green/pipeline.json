        },
        {
            "id": 6,
            "type": "timeseries",
            "title": "Topic Offset Growth Rate",
            "description": "Non-negative growth rate of Kafka topic partition current offsets, summed by topic.",
            "gridPos": {
                "x": 12,
                "y": 5,
                "w": 12,
                "h": 7
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "sum by (topic) (clamp_min(deriv(kafka_topic_partition_current_offset[$__rate_interval]), 0))",
                    "legendFormat": "{{topic}}"
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "right",
                    "width": 220,
                    "calcs": [
                        "max"
                    ],
                    "sortBy": "Max",
                    "sortDesc": true
                },
                "tooltip": {
                    "mode": "multi"
