            },
            "fieldConfig": {
                "defaults": {
                    "unit": "suffix: offsets/s",
                    "min": 0,
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 2,
                        "fillOpacity": 12,
                        "showPoints": "never",
                        "spanNulls": false,
                        "stacking": {
                            "mode": "none",
                            "group": "A"
