                    "expr": "clamp_min(max({job=\"urbangreen-spark-streaming\", __name__=~\"metrics_app_.*_driver_spark_streaming_.*_latency_Value\"}) - 60000, 0) / 1000",
                    "legendFormat": "Scheduling overrun"
