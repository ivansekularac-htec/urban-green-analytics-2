        {
            "id": 15,
            "type": "row",
            "title": "Airflow (from logs)",
            "collapsed": false,
            "gridPos": {
                "x": 0,
                "y": 47,
                "w": 24,
                "h": 1
            },
            "panels": []
        },
        {
            "id": 16,
            "type": "timeseries",
            "title": "Task Transitions: SUCCESS / FAILED",
            "description": "Log-derived counts per time bucket of Airflow 3.x supervisor 'Task finished' events with final_state SUCCESS or FAILED. Docker logs are selected by absent dag and filename labels to avoid counting file-scraped task logs again. Counts cover all DAGs: the supervisor event contains a task-instance UUID but no DAG/task/run labels. Tasks completed without a supervisor event, such as optimized EmptyOperator barriers, are not counted. Retry and skipped states are excluded; retries that eventually finish produce their own outcomes. A zero means no matching event in that bucket, and is not a health check for log ingestion. Exact log strings depend on the upstream Airflow 3.x message format. If they shift in a future version, update the LogQL filters.",
            "gridPos": {
                "x": 0,
                "y": 48,
                "w": 24,
                "h": 8
            },
            "datasource": {
                "type": "loki",
                "uid": "loki"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "loki",
                        "uid": "loki"
                    },
                    "expr": "sum(count_over_time({service=\"urbangreen-airflow\",dag=\"\",filename=\"\"} |= \"Task finished\" | decolorize |~ \"(?i)final_state[\\\"'[:space:]]*[:=][\\\"'[:space:]]*<?(TaskInstanceState[.])?success\\\\b\" [$__interval])) or vector(0)",
                    "legendFormat": "SUCCESS",
                    "queryType": "range"
                },
                {
                    "refId": "B",
                    "datasource": {
                        "type": "loki",
                        "uid": "loki"
                    },
                    "expr": "sum(count_over_time({service=\"urbangreen-airflow\",dag=\"\",filename=\"\"} |= \"Task finished\" | decolorize |~ \"(?i)final_state[\\\"'[:space:]]*[:=][\\\"'[:space:]]*<?(TaskInstanceState[.])?failed\\\\b\" [$__interval])) or vector(0)",
                    "legendFormat": "FAILED",
                    "queryType": "range"
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "bottom",
                    "calcs": [
                        "lastNotNull",
                        "max"
                    ]
                },
                "tooltip": {
                    "mode": "multi"
                }
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "min": 0,
                    "noValue": "NO DATA",
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "drawStyle": "bars",
                        "lineWidth": 1,
                        "fillOpacity": 60,
                        "stacking": {
                            "mode": "normal"
                        },
                        "spanNulls": false
                    }
                },
                "overrides": [
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "SUCCESS"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "mode": "fixed",
                                    "fixedColor": "#4CBB8A"
                                }
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "FAILED"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "mode": "fixed",
                                    "fixedColor": "red"
                                }
                            }
                        ]
                    }
                ]
            }
        },
        {
            "id": 17,
            "type": "logs",
            "title": "Airflow Errors / Tracebacks",
            "description": "Airflow errors and traceback-bearing log lines from Loki, including Docker service logs and file-scraped task logs. File streams carry dag, task, and run_id labels when Promtail extracts them. JSON task logs can contain escaped multiline tracebacks in one log entry; this query filters raw content without assuming JSON for every stream. Exact log strings depend on the upstream Airflow 3.x message format. If they shift in a future version, update the LogQL filters.",
            "gridPos": {
                "x": 0,
                "y": 56,
                "w": 24,
                "h": 10
            },
            "datasource": {
                "type": "loki",
                "uid": "loki"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "loki",
                        "uid": "loki"
                    },
                    "expr": "{service=\"urbangreen-airflow\"} | decolorize |~ \"(?i)\\\\berror\\\\b|\\\\bcritical\\\\b|traceback|task failed with exception\"",
                    "queryType": "range"
                }
            ],
            "options": {
                "showTime": true,
                "showLabels": true,
                "showCommonLabels": false,
                "wrapLogMessage": true,
                "prettifyLogMessage": true,
                "enableLogDetails": true,
                "dedupStrategy": "none",
                "sortOrder": "Descending"
            }
        }
    ]
}
