                    "expr": "sum(increase(label_replace({job=\"urbangreen-spark-streaming\", __name__=~\"metrics_app_.*_driver_appStatus_jobs_failedJobs_Count\"}, \"spark_metric\", \"$1\", \"__name__\", \"(.*)\")[5m:]))",
                    "legendFormat": "Failed Jobs / 5m"
                }
