                    "noValue": "0",
                    "decimals": 0,
                    "color": {
                        "mode": "fixed",
                        "fixedColor": "#4CBB8A"
                    }
                },
                "overrides": []
            }
        },
        {
            "id": 3,
            "type": "stat",
            "title": "Total Consumer Lag",
            "description": "Total lag across Kafka consumer groups with committed offsets. The current Spark Structured Streaming consumer does not commit a persistent Kafka consumer group, so zero is expected unless another committed group exists.",
            "gridPos": {
                "x": 8,
                "y": 1,
                "w": 8,
                "h": 4
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "sum(kafka_consumergroup_lag_sum) or vector(0)",
                    "instant": true
                }
            ],
            "options": {
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
