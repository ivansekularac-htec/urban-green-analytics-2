        {
            "id": 12,
            "type": "timeseries",
            "title": "Batch Processing Delay",
            "description": "Structured Streaming latency for the latest completed micro-batch, exported by Spark's streaming metrics source through PrometheusServlet.",
            "gridPos": {
                "x": 0,
                "y": 24,
                "w": 12,
                "h": 7
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "max({job=\"urbangreen-spark-streaming\", __name__=~\"metrics_app_.*_driver_spark_streaming_.*_latency_Value\"}) / 1000",
                    "legendFormat": "Batch latency"
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "table",
