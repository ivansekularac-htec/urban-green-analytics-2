{
    "uid": "pipeline",
    "title": "Pipeline",
    "description": "Data-flow stack: Kafka consumer lag and topic offsets (kafka-exporter), Spark cluster and streaming job state (PrometheusServlet), Airflow task outcomes from Loki logs.",
    "tags": [
        "urbangreen",
        "observability",
        "pipeline"
    ],
    "timezone": "browser",
    "editable": false,
    "graphTooltip": 1,
    "schemaVersion": 39,
    "version": 1,
    "refresh": "30s",
    "time": {
        "from": "now-6h",
        "to": "now"
    },
    "templating": {
        "list": []
    },
    "annotations": {
        "list": []
    },
    "links": [],
    "panels": [
        {
            "id": 1,
            "type": "row",
            "title": "Kafka",
            "collapsed": false,
            "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
            "panels": []
        },
        {
            "id": 2,
            "type": "timeseries",
            "title": "Consumer lag by group / topic",
            "description": "Sum of kafka_consumergroup_lag from kafka-exporter, excluding internal __* topics. Lag is log-end offset minus the consumer group's committed offset.",
            "gridPos": { "x": 0, "y": 1, "w": 12, "h": 8 },
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "targets": [
                {
                    "refId": "A",
                    "datasource": { "type": "prometheus", "uid": "prometheus" },
                    "expr": "sum by (consumergroup, topic) (kafka_consumergroup_lag{topic!~\"__.+\"})",
                    "legendFormat": "{{consumergroup}} / {{topic}}"
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "right",
                    "width": 220,
                    "calcs": ["max"],
                    "sortBy": "Max",
                    "sortDesc": true
                },
                "tooltip": { "mode": "multi" }
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "min": 0,
                    "custom": {
                        "drawStyle": "line",
                        "lineWidth": 2,
                        "fillOpacity": 12,
                        "showPoints": "never",
                        "spanNulls": false
                    }
                },
                "overrides": []
            }
        },
        {
            "id": 3,
            "type": "timeseries",
            "title": "Topic offset growth",
            "description": "Rate of kafka_topic_partition_current_offset from kafka-exporter (messages/sec produced per topic). Internal __* topics are excluded.",
            "gridPos": { "x": 12, "y": 1, "w": 12, "h": 8 },
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "targets": [
                {
                    "refId": "A",
                    "datasource": { "type": "prometheus", "uid": "prometheus" },
                    "expr": "sum by (topic) (rate(kafka_topic_partition_current_offset{topic!~\"__.+\"}[$__rate_interval]))",
                    "legendFormat": "{{topic}}"
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "right",
                    "width": 180,
                    "calcs": ["max"],
                    "sortBy": "Max",
                    "sortDesc": true
                },
                "tooltip": { "mode": "multi" }
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "ops",
                    "min": 0,
                    "custom": {
                        "drawStyle": "line",
                        "lineWidth": 2,
                        "fillOpacity": 12,
                        "showPoints": "never",
                        "spanNulls": false
                    }
                },
                "overrides": []
            }
        },
        {
            "id": 10,
            "type": "row",
            "title": "Spark",
            "collapsed": false,
            "gridPos": { "x": 0, "y": 9, "w": 24, "h": 1 },
            "panels": []
        },
        {
            "id": 11,
            "type": "stat",
            "title": "Workers",
            "description": "metrics_master_workers_Number from the Spark master PrometheusServlet.",
            "gridPos": { "x": 0, "y": 10, "w": 6, "h": 4 },
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "targets": [
                {
                    "refId": "A",
                    "datasource": { "type": "prometheus", "uid": "prometheus" },
                    "expr": "sum(metrics_master_workers_Number) or vector(0)",
                    "instant": true
                }
            ],
            "options": {
                "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
                "colorMode": "background",
                "graphMode": "none",
                "textMode": "value",
                "justifyMode": "center"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "min": 0,
                    "noValue": "0",
                    "decimals": 0,
                    "color": { "mode": "fixed", "fixedColor": "#89BDB0" }
                },
                "overrides": []
            }
        },
        {
            "id": 12,
            "type": "stat",
            "title": "Alive workers",
            "description": "metrics_master_aliveWorkers_Number from the Spark master PrometheusServlet.",
            "gridPos": { "x": 6, "y": 10, "w": 6, "h": 4 },
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "targets": [
                {
                    "refId": "A",
                    "datasource": { "type": "prometheus", "uid": "prometheus" },
                    "expr": "sum(metrics_master_aliveWorkers_Number) or vector(0)",
                    "instant": true
                }
            ],
            "options": {
                "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
                "colorMode": "background",
                "graphMode": "none",
                "textMode": "value",
                "justifyMode": "center"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "min": 0,
                    "noValue": "0",
                    "decimals": 0,
                    "color": { "mode": "fixed", "fixedColor": "#4CBB8A" }
                },
                "overrides": []
            }
        },
        {
            "id": 13,
            "type": "stat",
            "title": "Running apps",
            "description": "metrics_master_apps_Number from the Spark master PrometheusServlet. Spikes while warehouse_load SparkSubmit jobs are running.",
            "gridPos": { "x": 12, "y": 10, "w": 6, "h": 4 },
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "targets": [
                {
                    "refId": "A",
                    "datasource": { "type": "prometheus", "uid": "prometheus" },
                    "expr": "sum(metrics_master_apps_Number) or vector(0)",
                    "instant": true
                }
            ],
            "options": {
                "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
                "colorMode": "background",
                "graphMode": "none",
                "textMode": "value",
                "justifyMode": "center"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "min": 0,
                    "noValue": "0",
                    "decimals": 0,
                    "color": { "mode": "fixed", "fixedColor": "#B7D3C0" }
                },
                "overrides": []
            }
        },
        {
            "id": 14,
            "type": "stat",
            "title": "Waiting apps",
            "description": "metrics_master_waitingApps_Number from the Spark master PrometheusServlet.",
            "gridPos": { "x": 18, "y": 10, "w": 6, "h": 4 },
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "targets": [
                {
                    "refId": "A",
                    "datasource": { "type": "prometheus", "uid": "prometheus" },
                    "expr": "sum(metrics_master_waitingApps_Number) or vector(0)",
                    "instant": true
                }
            ],
            "options": {
                "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
                "colorMode": "background",
                "graphMode": "none",
                "textMode": "value",
                "justifyMode": "center"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "min": 0,
                    "noValue": "0",
                    "decimals": 0,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            { "value": null, "color": "#4CBB8A" },
                            { "value": 1, "color": "orange" }
                        ]
                    }
                },
                "overrides": []
            }
        },
        {
            "id": 15,
            "type": "timeseries",
            "title": "Structured Streaming batch delays",
            "description": "Processing delay is spark.streaming latency (last micro-batch triggerExecution, ms) from the streaming driver PrometheusServlet. Scheduling delay uses the classic lastCompletedBatch_schedulingDelay name when present. Requires spark.sql.streaming.metricsEnabled=true on the streaming driver.",
            "gridPos": { "x": 0, "y": 14, "w": 8, "h": 8 },
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "targets": [
                {
                    "refId": "A",
                    "datasource": { "type": "prometheus", "uid": "prometheus" },
                    "expr": "max({__name__=~\"metrics_.*spark_streaming.*_latency_Number\"})",
                    "legendFormat": "processing delay"
                },
                {
                    "refId": "B",
                    "datasource": { "type": "prometheus", "uid": "prometheus" },
                    "expr": "max({__name__=~\"metrics_.*lastCompletedBatch_schedulingDelay_Number\"})",
                    "legendFormat": "scheduling delay"
                }
            ],
            "options": {
                "legend": { "displayMode": "list", "placement": "bottom" },
                "tooltip": { "mode": "multi" }
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "ms",
                    "min": 0,
                    "custom": {
                        "drawStyle": "line",
                        "lineWidth": 2,
                        "fillOpacity": 12,
                        "showPoints": "never",
                        "spanNulls": false
                    }
                },
                "overrides": []
            }
        },
        {
            "id": 16,
            "type": "timeseries",
            "title": "Job activity",
            "description": "DAGScheduler active / all jobs and running stages from PrometheusServlet. Name regex is required because Spark embeds app id in the metric name.",
            "gridPos": { "x": 8, "y": 14, "w": 8, "h": 8 },
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "targets": [
                {
                    "refId": "A",
                    "datasource": { "type": "prometheus", "uid": "prometheus" },
                    "expr": "sum({__name__=~\"metrics_.*_DAGScheduler_job_activeJobs_Number\"}) or vector(0)",
                    "legendFormat": "active jobs"
                },
                {
                    "refId": "B",
                    "datasource": { "type": "prometheus", "uid": "prometheus" },
                    "expr": "sum({__name__=~\"metrics_.*_DAGScheduler_job_allJobs_Number\"}) or vector(0)",
                    "legendFormat": "all jobs"
                },
                {
                    "refId": "C",
                    "datasource": { "type": "prometheus", "uid": "prometheus" },
                    "expr": "sum({__name__=~\"metrics_.*_DAGScheduler_stage_runningStages_Number\"}) or vector(0)",
                    "legendFormat": "running stages"
                }
            ],
            "options": {
                "legend": { "displayMode": "list", "placement": "bottom" },
                "tooltip": { "mode": "multi" }
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "min": 0,
                    "custom": {
                        "drawStyle": "line",
                        "lineWidth": 2,
                        "fillOpacity": 12,
                        "showPoints": "never",
                        "spanNulls": false
                    }
                },
                "overrides": []
            }
        },
        {
            "id": 17,
            "type": "timeseries",
            "title": "GC time",
            "description": "Rate of executor Minor/Major GC time from PrometheusServlet ExecutorMetrics (milliseconds per second).",
            "gridPos": { "x": 16, "y": 14, "w": 8, "h": 8 },
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "targets": [
                {
                    "refId": "A",
                    "datasource": { "type": "prometheus", "uid": "prometheus" },
                    "expr": "sum({__name__=~\"metrics_.*_ExecutorMetrics_MinorGCTime_Number\"})",
                    "legendFormat": "minor GC"
                },
                {
                    "refId": "B",
                    "datasource": { "type": "prometheus", "uid": "prometheus" },
                    "expr": "sum({__name__=~\"metrics_.*_ExecutorMetrics_MajorGCTime_Number\"})",
                    "legendFormat": "major GC"
                }
            ],
            "options": {
                "legend": { "displayMode": "list", "placement": "bottom" },
                "tooltip": { "mode": "multi" }
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "ms",
                    "min": 0,
                    "custom": {
                        "drawStyle": "line",
                        "lineWidth": 2,
                        "fillOpacity": 12,
                        "showPoints": "never",
                        "spanNulls": false
                    }
                },
                "overrides": []
            }
        },
        {
            "id": 20,
            "type": "row",
            "title": "Airflow (from logs)",
            "collapsed": false,
            "gridPos": { "x": 0, "y": 22, "w": 24, "h": 1 },
            "panels": []
        },
        {
            "id": 21,
            "type": "timeseries",
            "title": "Task SUCCESS / FAILED transitions",
            "description": "Log-derived counts of Airflow task terminal-state transitions. There is no Airflow exporter; Loki is the only signal. Exact log strings depend on the upstream Airflow 3.x message format — if they shift in a future version, update the LogQL filters. Current filters match Airflow 3.1 supervisor lines ('Task finished' + final_state=success|failed) and the classic 'Marking task as SUCCESS|FAILED' wording.",
            "gridPos": { "x": 0, "y": 23, "w": 24, "h": 8 },
            "datasource": { "type": "loki", "uid": "loki" },
            "targets": [
                {
                    "refId": "A",
                    "datasource": { "type": "loki", "uid": "loki" },
                    "expr": "sum(count_over_time({service=\"urbangreen-airflow\"} |~ \"(?i)(Task finished.*final_state[=:] ?success|Marking task as SUCCESS)\" [$__interval]))",
                    "legendFormat": "SUCCESS"
                },
                {
                    "refId": "B",
                    "datasource": { "type": "loki", "uid": "loki" },
                    "expr": "sum(count_over_time({service=\"urbangreen-airflow\"} |~ \"(?i)(Task finished.*final_state[=:] ?failed|Marking task as FAILED)\" [$__interval]))",
                    "legendFormat": "FAILED"
                }
            ],
            "options": {
                "legend": { "displayMode": "list", "placement": "bottom" },
                "tooltip": { "mode": "multi" }
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "min": 0,
                    "custom": {
                        "drawStyle": "bars",
                        "fillOpacity": 60,
                        "lineWidth": 1,
                        "stacking": { "mode": "normal" }
                    }
                },
                "overrides": [
                    {
                        "matcher": { "id": "byName", "options": "SUCCESS" },
                        "properties": [
                            { "id": "color", "value": { "mode": "fixed", "fixedColor": "#4CBB8A" } }
                        ]
                    },
                    {
                        "matcher": { "id": "byName", "options": "FAILED" },
                        "properties": [
                            { "id": "color", "value": { "mode": "fixed", "fixedColor": "#28594F" } }
                        ]
                    }
                ]
            }
        },
        {
            "id": 22,
            "type": "logs",
            "title": "Errors and tracebacks",
            "description": "Airflow log lines that look like errors or tracebacks. Exact log strings depend on the upstream Airflow 3.x message format — if they shift in a future version, update the LogQL filters.",
            "gridPos": { "x": 0, "y": 31, "w": 24, "h": 10 },
            "datasource": { "type": "loki", "uid": "loki" },
            "targets": [
                {
                    "refId": "A",
                    "datasource": { "type": "loki", "uid": "loki" },
                    "expr": "{service=\"urbangreen-airflow\"} |~ \"(?i)(traceback|exception|error|final_state[=:] ?failed|Marking task as FAILED)\""
                }
            ],
            "options": {
                "showTime": true,
                "showLabels": false,
                "showCommonLabels": false,
                "wrapLogMessage": true,
                "prettifyLogMessage": false,
                "enableLogDetails": true,
                "dedupStrategy": "none",
                "sortOrder": "Descending"
            }
        }
    ]
}