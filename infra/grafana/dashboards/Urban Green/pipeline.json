        {
            "id": 15,
            "type": "timeseries",
            "title": "Structured Streaming Jobs (5m)",
            "description": "Succeeded and failed Spark jobs completed in the trailing 5-minute window for the persistent Structured Streaming driver. The metric name is copied into a temporary label before increase() so Spark application restarts do not create duplicate Prometheus label sets.",
            "gridPos": {
                "x": 0,
                "y": 38,
                "w": 12,
                "h": 7
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "sum(increase(label_replace({job=\"urbangreen-spark-streaming\", __name__=~\"metrics_app_.*_driver_appStatus_jobs_succeededJobs_Count\"}, \"spark_metric\", \"$1\", \"__name__\", \"(.*)\")[5m:]))",
                    "legendFormat": "Succeeded Jobs / 5m"
                },
                {
                    "refId": "B",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
