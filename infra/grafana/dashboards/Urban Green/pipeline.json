        {
            "id": 13,
            "type": "timeseries",
            "title": "Scheduling Delay",
            "description": "Derived processing-time scheduling overrun: max(Structured Streaming latency - 60 s trigger interval, 0). Spark does not expose a separate scheduling-delay gauge through this PrometheusServlet.",
