        {
            "id": 15,
            "type": "row",
            "title": "Airflow (from logs)",
            "collapsed": false,
            "gridPos": {
                "x": 0,
                "y": 31,
                "w": 24,
                "h": 1
            },
            "panels": []
        },
        {
            "id": 16,
            "type": "timeseries",
            "title": "Task SUCCESS / FAILED transitions",
            "description": "Log-derived counts of Airflow task terminal-state transitions. There is no Airflow exporter; Loki is the only signal. Exact log strings depend on the upstream Airflow 3.x message format — if they shift in a future version, update the LogQL filters. Current filters match Airflow 3.1 supervisor lines ('Task finished' + final_state=success|failed) and the classic 'Marking task as SUCCESS|FAILED' wording.",
            "gridPos": {
                "x": 0,
                "y": 32,
                "w": 24,
                "h": 8
            },
            "datasource": {
                "type": "loki",
                "uid": "loki"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "loki",
                        "uid": "loki"
                    },
                    "expr": "sum(count_over_time({service=\"urbangreen-airflow\"} |~ \"(?i)(Task finished.*final_state[=:] ?success|Marking task as SUCCESS)\" [$__interval]))",
                    "legendFormat": "SUCCESS"
                },
                {
                    "refId": "B",
                    "datasource": {
                        "type": "loki",
                        "uid": "loki"
                    },
                    "expr": "sum(count_over_time({service=\"urbangreen-airflow\"} |~ \"(?i)(Task finished.*final_state[=:] ?failed|Marking task as FAILED)\" [$__interval]))",
                    "legendFormat": "FAILED"
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "multi"
                }
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "min": 0,
                    "noValue": "NO DATA",
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "drawStyle": "bars",
                        "fillOpacity": 60,
                        "lineWidth": 1,
                        "stacking": {
                            "mode": "normal"
                        }
                    }
                },
                "overrides": [
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "SUCCESS"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "mode": "fixed",
                                    "fixedColor": "#4CBB8A"
                                }
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "FAILED"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "mode": "fixed",
                                    "fixedColor": "#28594F"
                                }
                            }
                        ]
                    }
                ]
            }
        },
        {
            "id": 17,
            "type": "logs",
            "title": "Errors and tracebacks",
            "description": "Airflow log lines that look like errors or tracebacks. Exact log strings depend on the upstream Airflow 3.x message format — if they shift in a future version, update the LogQL filters.",
            "gridPos": {
                "x": 0,
                "y": 40,
                "w": 24,
                "h": 10
            },
            "datasource": {
                "type": "loki",
                "uid": "loki"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "loki",
                        "uid": "loki"
                    },
                    "expr": "{service=\"urbangreen-airflow\"} |~ \"(?i)(traceback|exception|error|final_state[=:] ?failed|Marking task as FAILED)\""
                }
            ],
            "options": {
                "showTime": true,
                "showLabels": true,
                "showCommonLabels": false,
                "wrapLogMessage": true,
                "prettifyLogMessage": true,
                "enableLogDetails": true,
                "dedupStrategy": "none",
                "sortOrder": "Descending"
            }
