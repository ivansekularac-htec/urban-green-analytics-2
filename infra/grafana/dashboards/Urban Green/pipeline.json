        {
            "id": 2,
            "type": "stat",
            "title": "Kafka Brokers",
            "description": "Number of Kafka brokers currently visible to kafka-exporter.",
            "gridPos": {
                "x": 0,
                "y": 1,
                "w": 8,
                "h": 4
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "max(kafka_brokers) or vector(0)",
                    "instant": true
                }
            ],
            "options": {
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "colorMode": "background",
                "graphMode": "none",
