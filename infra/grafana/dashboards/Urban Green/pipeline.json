        },
        {
            "id": 13,
            "type": "timeseries",
            "title": "Streaming Job Outcomes",
            "description": "Succeeded and failed Spark jobs per second from the streaming driver's appStatus counters, using rate to handle application restarts. These are Spark jobs, not Airflow task outcomes. warehouse_load runs client-mode drivers inside Airflow, which are not scraped by the existing Prometheus configuration.",
            "gridPos": {
                "x": 0,
                "y": 30,
                "w": 12,
                "h": 8
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "sum(rate(label_replace({__name__=~\"metrics_.*_driver_appStatus_jobs_succeededJobs_Count\",job=\"urbangreen-spark-streaming\"}, \"spark_metric\", \"$1\", \"__name__\", \"(.+)\")[$__rate_interval:15s]))",
                    "legendFormat": "Succeeded",
                    "instant": false,
                    "range": true
                },
                {
                    "refId": "B",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "sum(rate(label_replace({__name__=~\"metrics_.*_driver_appStatus_jobs_failedJobs_Count\",job=\"urbangreen-spark-streaming\"}, \"spark_metric\", \"$1\", \"__name__\", \"(.+)\")[$__rate_interval:15s]))",
                    "legendFormat": "Failed",
                    "instant": false,
                    "range": true
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "bottom",
                    "calcs": [
                        "lastNotNull",
                        "max"
                    ]
                },
                "tooltip": {
                    "mode": "multi"
                }
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "ops",
                    "min": 0,
                    "noValue": "NO DATA",
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 2,
                        "fillOpacity": 10,
                        "spanNulls": false,
                        "stacking": {
                            "mode": "none"
                        }
                    }
                },
                "overrides": [
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "Succeeded"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "mode": "fixed",
                                    "fixedColor": "#4CBB8A"
                                }
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "Failed"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "mode": "fixed",
                                    "fixedColor": "red"
                                }
                            }
                        ]
                    }
                ]
            }
        },
        {
            "id": 14,
            "type": "timeseries",
            "title": "JVM GC Time by Spark Process",
            "description": "Garbage-collection time in milliseconds per second, summed across collectors in each scraped Spark JVM: master, workers, and streaming driver. GC collection times are cumulative even though PrometheusServlet exports them as gauges; rate handles resets. Only the Value copy is selected, and negative/unavailable JVM collection times are excluded. These are process JVM measurements, not warehouse_load executor GC measurements.",
            "gridPos": {
                "x": 12,
                "y": 30,
                "w": 12,
                "h": 8
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "sum by (job) (rate(label_replace({__name__=~\"metrics_.*jvm_.*_time_Value\",job=~\"urbangreen-spark-(master|worker-[12]|streaming)\"} >= 0, \"spark_metric\", \"$1\", \"__name__\", \"(.+)\")[$__rate_interval:15s]))",
                    "legendFormat": "{{job}}",
                    "instant": false,
                    "range": true
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "bottom",
                    "calcs": [
                        "lastNotNull",
                        "max"
                    ]
                },
                "tooltip": {
                    "mode": "multi"
                }
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "ms",
                    "min": 0,
                    "noValue": "NO DATA",
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 2,
                        "fillOpacity": 10,
                        "spanNulls": false,
                        "stacking": {
                            "mode": "none"
                        }
                    }
                },
                "overrides": []
            }
