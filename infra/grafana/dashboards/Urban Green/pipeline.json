        {
            "id": 5,
            "type": "bargauge",
            "title": "Consumer Lag by Group / Topic",
            "description": "Lag for Kafka consumer groups that have committed offsets. No series are expected when no committed consumer groups exist.",
            "gridPos": {
                "x": 0,
                "y": 5,
                "w": 12,
                "h": 7
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "sort_desc(kafka_consumergroup_lag_sum)",
                    "legendFormat": "{{consumergroup}} / {{topic}}",
                    "instant": true
                }
            ],
            "options": {
                "orientation": "horizontal",
                "displayMode": "basic",
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
