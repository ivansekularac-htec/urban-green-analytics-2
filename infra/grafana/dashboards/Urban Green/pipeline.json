        {
            "id": 7,
            "type": "stat",
            "title": "Running Apps",
            "description": "Registered applications minus WAITING applications, from the master PrometheusServlet. warehouse_load submits Spark applications and should change this value while they run; short apps may finish between the 15-second scrapes.",
