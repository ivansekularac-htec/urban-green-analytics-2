            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "clamp_min(metrics_master_apps_Value{job=\"urbangreen-spark-master\"} - metrics_master_waitingApps_Value{job=\"urbangreen-spark-master\"}, 0)",
                    "legendFormat": "Running Apps",
                    "instant": true,
                    "range": false
