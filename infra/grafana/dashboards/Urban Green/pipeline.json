        {
            "id": 12,
            "type": "timeseries",
            "title": "Active Executors by Worker",
            "description": "Active executors per Spark worker, from each worker's PrometheusServlet. Includes both sensor_readings_stream and warehouse_load applications, so triggering warehouse_load should populate cluster activity. Driver job counters below are scoped to the separately scraped streaming driver.",
