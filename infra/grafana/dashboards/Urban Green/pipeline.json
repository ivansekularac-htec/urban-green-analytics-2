{
    "uid": "pipeline",
    "title": "Pipeline",
    "description": "Kafka consumer lag and topic offset growth, Spark cluster and Structured Streaming activity, and Airflow task outcomes derived from Loki logs. Streaming scheduling delay is shown as a trigger-overrun estimate.",
    "tags": [
        "urbangreen",
        "observability",
        "pipeline"
    ],
    "timezone": "browser",
    "editable": false,
    "graphTooltip": 1,
    "schemaVersion": 39,
    "version": 1,
    "refresh": "30s",
    "time": {
        "from": "now-6h",
        "to": "now"
    },
    "templating": {
        "list": [
            {
                "name": "trigger_interval_ms",
                "type": "textbox",
                "label": "Trigger interval (ms)",
                "description": "Positive numeric trigger interval in milliseconds for the scheduling overrun estimate. Match STREAM_TRIGGER_INTERVAL; the streaming job defaults to 60 seconds (60000 ms).",
                "query": "60000",
                "current": {
                    "selected": true,
                    "text": "60000",
                    "value": "60000"
                },
                "hide": 0
            }
        ]
    },
    "annotations": {
        "list": []
    },
    "links": [],
    "panels": [
        {
            "id": 1,
            "type": "row",
            "title": "Kafka",
            "collapsed": false,
            "gridPos": {
                "x": 0,
                "y": 0,
                "w": 24,
                "h": 1
            },
            "panels": []
        },
        {
            "id": 2,
            "type": "timeseries",
            "title": "Consumer lag by group / topic",
            "description": "Sum of kafka_consumergroup_lag from kafka-exporter, excluding internal __* topics. Lag is log-end offset minus the consumer group's committed offset.",
            "gridPos": {
                "x": 0,
                "y": 1,
                "w": 12,
                "h": 8
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "sum by (consumergroup, topic) (kafka_consumergroup_lag{topic!~\"__.+\"})",
                    "legendFormat": "{{consumergroup}} / {{topic}}"
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "right",
                    "width": 220,
                    "calcs": [
                        "max"
                    ],
                    "sortBy": "Max",
                    "sortDesc": true
                },
                "tooltip": {
                    "mode": "multi"
                }
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "min": 0,
                    "noValue": "NO DATA",
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 2,
                        "fillOpacity": 10,
                        "spanNulls": false,
                        "stacking": {
                            "mode": "none"
                        }
                    }
                },
                "overrides": []
            }
        },
        {
            "id": 3,
            "type": "timeseries",
            "title": "Topic offset growth",
            "description": "Rate of kafka_topic_partition_current_offset from kafka-exporter (messages/sec produced per topic). Internal __* topics are excluded.",
            "gridPos": {
                "x": 12,
                "y": 1,
                "w": 12,
                "h": 8
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "sum by (topic) (rate(kafka_topic_partition_current_offset{topic!~\"__.+\"}[$__rate_interval]))",
                    "legendFormat": "{{topic}}"
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "right",
                    "width": 180,
                    "calcs": [
                        "max"
                    ],
                    "sortBy": "Max",
                    "sortDesc": true
                },
                "tooltip": {
                    "mode": "multi"
                }
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "recps",
                    "min": 0,
                    "noValue": "NO DATA",
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "lineWidth": 2,
                        "fillOpacity": 10,
                        "spanNulls": false,
                        "stacking": {
                            "mode": "none"
                        }
                    }
                },
                "overrides": []
            }
        },
