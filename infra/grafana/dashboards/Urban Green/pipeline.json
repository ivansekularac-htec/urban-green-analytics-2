        {
            "id": 41,
            "type": "stat",
            "title": "Usable storage used",
            "description": "Share of MinIO usable capacity currently occupied. Source: minio_cluster_capacity_usable_*_bytes from /minio/v2/metrics/cluster.",
            "gridPos": {
                "x": 0,
                "y": 39,
                "w": 6,
                "h": 8
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "100 * (1 - minio_cluster_capacity_usable_free_bytes / minio_cluster_capacity_usable_total_bytes)",
                    "instant": true
                }
            ],
            "options": {
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "colorMode": "background",
                "graphMode": "none",
                "textMode": "value",
                "justifyMode": "center"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "min": 0,
                    "max": 100,
                    "decimals": 1,
                    "noValue": "—",
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "value": null,
                                "color": "#4CBB8A"
                            },
                            {
                                "value": 80,
                                "color": "orange"
                            },
                            {
                                "value": 95,
                                "color": "red"
                            }
                        ]
                    }
                },
                "overrides": []
            }
        },
        {
            "id": 42,
            "type": "timeseries",
            "title": "S3 request rate by API",
            "description": "rate(minio_s3_requests_total). PutObject from Spark streaming, GetObject/List from Airflow warehouse loads.",
            "gridPos": {
                "x": 6,
                "y": 39,
                "w": 9,
                "h": 8
            },
            "datasource": {
                "type": "prometheus",
