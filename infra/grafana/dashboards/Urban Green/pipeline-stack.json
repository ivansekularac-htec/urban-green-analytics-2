{
    "uid": "pipeline-stack",
    "title": "Pipeline",
    "description": "Pipeline observability dashboard for Kafka, Spark and Airflow. Spark app metrics are aggregated before rate() so multiple Spark application metric names cannot create duplicate labelsets.",
    "tags": [
        "urbangreen",
        "observability",
        "pipeline",
        "kafka",
        "spark",
        "airflow"
    ],
    "timezone": "browser",
    "editable": true,
    "graphTooltip": 1,
    "schemaVersion": 39,
    "version": 12,
    "refresh": "30s",
    "time": {
        "from": "now-6h",
        "to": "now"
    },
    "templating": {
        "list": [
            {
                "name": "trigger_interval_ms",
                "type": "textbox",
                "label": "Trigger interval (ms)",
                "description": "Configured Spark Structured Streaming trigger interval used for the estimated trigger-overrun panel.",
                "query": "60000",
                "current": {
                    "selected": true,
                    "text": "60000",
                    "value": "60000"
                },
                "hide": 0
            }
        ]
    },
    "annotations": {
        "list": []
    },
    "links": [],
    "panels": [
        {
            "id": 1,
            "type": "row",
            "title": "Kafka",
            "collapsed": false,
            "gridPos": {
                "x": 0,
                "y": 0,
                "w": 24,
                "h": 1
            },
            "panels": []
        },
        {
            "id": 2,
            "type": "stat",
            "title": "Kafka Exporter Status",
            "description": "Availability of the kafka-exporter scrape target. 1 means Prometheus can scrape the exporter.",
            "gridPos": {
                "x": 0,
                "y": 1,
                "w": 6,
                "h": 4
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "up{job=\"urbangreen-kafka-exporter\"}",
                    "instant": true
                }
            ],
            "options": {
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "colorMode": "background",
                "graphMode": "none",
                "textMode": "value",
                "justifyMode": "center"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "min": 0,
                    "max": 1,
                    "noValue": "0",
                    "decimals": 0,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "value": null,
                                "color": "red"
                            },
                            {
                                "value": 1,
                                "color": "#4CBB8A"
                            }
                        ]
                    }
                },
                "overrides": []
            }
        },
        {
            "id": 3,
            "type": "stat",
            "title": "Current Consumer Lag",
            "description": "Current unconsumed Kafka records across all consumer groups and topics. A rising value indicates downstream consumption is falling behind ingestion.",
            "gridPos": {
                "x": 0,
                "y": 5,
                "w": 6,
                "h": 4
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "sum(kafka_consumergroup_lag{job=\"urbangreen-kafka-exporter\"}) or vector(0)",
                    "instant": true
                }
            ],
            "options": {
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "colorMode": "background",
                "graphMode": "none",
                "textMode": "value",
                "justifyMode": "center"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "min": 0,
                    "noValue": "0",
                    "decimals": 0,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "value": null,
                                "color": "#4CBB8A"
                            },
                            {
                                "value": 100,
                                "color": "#89BDB0"
                            },
                            {
                                "value": 1000,
                                "color": "#28594F"
                            }
                        ]
                    }
                },
                "overrides": []
            }
        },
        {
            "id": 5,
            "type": "timeseries",
            "title": "Topic Offset Growth",
            "description": "Growth of Kafka topic latest offsets in records per second, summed across partitions. Negative slopes caused by topic resets are clamped to zero.",
            "gridPos": {
                "x": 6,
                "y": 1,
                "w": 18,
                "h": 8
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "sum by (topic) (clamp_min(deriv(kafka_topic_partition_current_offset{job=\"urbangreen-kafka-exporter\"}[$__rate_interval]), 0))",
                    "legendFormat": "{{topic}}",
                    "range": true
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "bottom",
                    "calcs": [
                        "lastNotNull",
                        "max"
                    ]
                },
                "tooltip": {
                    "mode": "multi"
                }
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "min": 0,
                    "noValue": "NO DATA",
                    "custom": {
                        "drawStyle": "line",
                        "lineWidth": 2,
                        "fillOpacity": 12,
                        "spanNulls": false
                    },
                    "color": {
                        "mode": "fixed",
                        "fixedColor": "#4CBB8A"
                    }
                },
                "overrides": []
            }
        },
        {
            "id": 6,
            "type": "row",
            "title": "Spark",
            "collapsed": false,
            "gridPos": {
                "x": 0,
                "y": 10,
                "w": 24,
                "h": 1
            },
            "panels": []
        },
        {
            "id": 7,
            "type": "stat",
            "title": "Spark Cluster State",
            "description": "Current Spark master state: alive workers, running applications, and waiting applications. These values come from the Spark master's PrometheusServlet.",
            "gridPos": {
                "x": 0,
                "y": 11,
                "w": 24,
                "h": 5
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "sum(metrics_master_aliveWorkers_Value{job=\"urbangreen-spark-master\"})",
                    "legendFormat": "Alive workers",
                    "instant": true
                },
                {
                    "refId": "B",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "clamp_min(sum(metrics_master_apps_Value{job=\"urbangreen-spark-master\"}) - sum(metrics_master_waitingApps_Value{job=\"urbangreen-spark-master\"}), 0)",
                    "legendFormat": "Running apps",
                    "instant": true
                },
                {
                    "refId": "C",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "sum(metrics_master_waitingApps_Value{job=\"urbangreen-spark-master\"})",
                    "legendFormat": "Waiting apps",
                    "instant": true
                }
            ],
            "options": {
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": true
                },
                "colorMode": "background",
                "graphMode": "none",
                "textMode": "value_and_name",
                "justifyMode": "auto",
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                }
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "min": 0,
                    "noValue": "0",
                    "decimals": 0,
                    "color": {
                        "mode": "fixed",
                        "fixedColor": "#89BDB0"
                    }
                },
                "overrides": []
            }
        },
        {
            "id": 8,
            "type": "timeseries",
            "title": "Active Executors by Worker",
            "description": "Active Spark executors reported by each worker. This is the cluster-activity panel for batch and streaming applications; a warehouse_load run should create visible worker executor activity while it is executing.",
            "gridPos": {
                "x": 12,
                "y": 16,
                "w": 12,
                "h": 9
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "metrics_worker_executors_Value{job=~\"urbangreen-spark-worker-[12]\"}",
                    "legendFormat": "{{job}}",
                    "range": true
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "bottom",
                    "calcs": [
                        "lastNotNull",
                        "max"
                    ]
                },
                "tooltip": {
                    "mode": "multi"
                }
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "min": 0,
                    "noValue": "NO DATA",
                    "custom": {
                        "drawStyle": "line",
                        "lineWidth": 2,
                        "fillOpacity": 12,
                        "spanNulls": false
                    },
                    "color": {
                        "mode": "palette-classic"
                    }
                },
                "overrides": [
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "urbangreen-spark-worker-1"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "mode": "fixed",
                                    "fixedColor": "#4CBB8A"
                                }
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "urbangreen-spark-worker-2"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "mode": "fixed",
                                    "fixedColor": "#28594F"
                                }
                            }
                        ]
                    }
                ]
            }
        },
        {
            "id": 9,
            "type": "timeseries",
            "title": "Streaming Batch Latency",
            "description": "Latest completed Structured Streaming batch latency from the streaming driver's PrometheusServlet metrics. This measures end-to-end batch processing latency; it is not a scheduler-delay gauge.",
            "gridPos": {
                "x": 0,
                "y": 16,
                "w": 12,
                "h": 9
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "max by (__name__) ({__name__=~\"metrics_.*_driver_spark_streaming_.*_latency_Value\",job=\"urbangreen-spark-streaming\"})",
                    "legendFormat": "Batch latency",
                    "range": true
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "bottom",
                    "calcs": [
                        "lastNotNull",
                        "max"
                    ]
                },
                "tooltip": {
                    "mode": "multi"
                }
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "ms",
                    "min": 0,
                    "noValue": "NO DATA",
                    "custom": {
                        "drawStyle": "line",
                        "lineWidth": 2,
                        "fillOpacity": 12,
                        "spanNulls": false
                    },
                    "color": {
                        "mode": "fixed",
                        "fixedColor": "#1F7A8C"
                    }
                },
                "overrides": []
            }
        },
        {
            "id": 10,
            "type": "timeseries",
            "title": "Streaming Input / Processing Rate",
            "description": "Input and processing rates of completed Structured Streaming batches. The metric names are matched by their stable suffix because the application ID and query UUID are embedded in the exported metric name.",
            "gridPos": {
                "x": 0,
                "y": 25,
                "w": 12,
                "h": 8
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "max by (__name__) ({__name__=~\"metrics_.*_driver_spark_streaming_.*_inputRate_total_Value\",job=\"urbangreen-spark-streaming\"})",
                    "legendFormat": "Input",
                    "range": true
                },
                {
                    "refId": "B",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "max by (__name__) ({__name__=~\"metrics_.*_driver_spark_streaming_.*_processingRate_total_Value\",job=\"urbangreen-spark-streaming\"})",
                    "legendFormat": "Processing",
                    "range": true
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "bottom",
                    "calcs": [
                        "lastNotNull",
                        "max"
                    ]
                },
                "tooltip": {
                    "mode": "multi"
                }
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "min": 0,
                    "noValue": "NO DATA",
                    "custom": {
                        "drawStyle": "line",
                        "lineWidth": 2,
                        "fillOpacity": 10,
                        "spanNulls": false
                    }
                },
                "overrides": [
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "Input"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "mode": "fixed",
                                    "fixedColor": "#89BDB0"
                                }
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "Processing"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "mode": "fixed",
                                    "fixedColor": "#28594F"
                                }
                            }
                        ]
                    }
                ]
            }
        },
        {
            "id": 11,
            "type": "timeseries",
            "title": "Streaming Trigger Overrun (estimated)",
            "description": "Estimate of processing duration above the configured Structured Streaming trigger interval. This is an estimate, not a direct Spark scheduler-delay measurement. Update the Trigger interval (ms) dashboard input when STREAM_TRIGGER_INTERVAL changes.",
            "gridPos": {
                "x": 12,
                "y": 25,
                "w": 12,
                "h": 8
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "clamp_min(max by (__name__) ({__name__=~\"metrics_.*_driver_spark_streaming_.*_latency_Value\",job=\"urbangreen-spark-streaming\"}) - ${trigger_interval_ms:raw}, 0)",
                    "legendFormat": "Estimated overrun",
                    "range": true
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "bottom",
                    "calcs": [
                        "lastNotNull",
                        "max"
                    ]
                },
                "tooltip": {
                    "mode": "multi"
                }
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "ms",
                    "min": 0,
                    "noValue": "NO DATA",
                    "custom": {
                        "drawStyle": "line",
                        "lineWidth": 2,
                        "fillOpacity": 12,
                        "spanNulls": false
                    },
                    "color": {
                        "mode": "fixed",
                        "fixedColor": "#28594F"
                    }
                },
                "overrides": []
            }
        },
        {
            "id": 12,
            "type": "timeseries",
            "title": "Streaming Job Outcomes",
            "description": "Succeeded and failed Spark jobs reported by the separately scraped Structured Streaming driver. These are Spark job outcomes, not Airflow task outcomes.",
            "gridPos": {
                "x": 0,
                "y": 33,
                "w": 12,
                "h": 9
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (job) (rate((sum by (job) ({__name__=~\"metrics_.*_driver_appStatus_jobs_succeededJobs_Count\",job=\"urbangreen-spark-streaming\"}))[$__rate_interval:]))",
                    "legendFormat": "Succeeded",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    }
                },
                {
                    "refId": "B",
                    "expr": "sum by (job) (rate((sum by (job) ({__name__=~\"metrics_.*_driver_appStatus_jobs_failedJobs_Count\",job=\"urbangreen-spark-streaming\"}))[$__rate_interval:]))",
                    "legendFormat": "Failed",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    }
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "bottom",
                    "calcs": [
                        "lastNotNull",
                        "max"
                    ]
                },
                "tooltip": {
                    "mode": "multi"
                }
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "ops",
                    "min": 0,
                    "noValue": "NO DATA",
                    "custom": {
                        "drawStyle": "line",
                        "lineWidth": 2,
                        "fillOpacity": 12,
                        "spanNulls": false
                    }
                },
                "overrides": [
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "Succeeded"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "mode": "fixed",
                                    "fixedColor": "#4CBB8A"
                                }
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "Failed"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "mode": "fixed",
                                    "fixedColor": "red"
                                }
                            }
                        ]
                    }
                ]
            }
        },
        {
            "id": 13,
            "type": "timeseries",
            "title": "JVM GC Time by Spark Process",
            "description": "JVM garbage-collection time across the scraped Spark master, workers, and streaming driver. This is a JVM pressure indicator; it is not executor-specific GC time for warehouse_load.",
            "gridPos": {
                "x": 12,
                "y": 33,
                "w": 12,
                "h": 9
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (job) (rate((sum by (job) ({__name__=~\"metrics_.*jvm_.*_time_Value\",job=~\"urbangreen-spark-(master|worker-1|worker-2|streaming)\"}))[$__rate_interval:]))",
                    "legendFormat": "{{job}}",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    }
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "bottom",
