                        "lastNotNull",
                        "max"
                    ]
                },
                "tooltip": {
                    "mode": "multi"
                }
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "ms",
                    "min": 0,
                    "noValue": "NO DATA",
                    "custom": {
                        "drawStyle": "line",
                        "lineWidth": 2,
                        "fillOpacity": 10,
                        "spanNulls": false
                    }
                },
                "overrides": [
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "urbangreen-spark-master"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "mode": "fixed",
                                    "fixedColor": "#4CBB8A"
                                }
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "urbangreen-spark-worker-1"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "mode": "fixed",
                                    "fixedColor": "#89BDB0"
                                }
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "urbangreen-spark-worker-2"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "mode": "fixed",
                                    "fixedColor": "#5C9E8A"
                                }
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "urbangreen-spark-streaming"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "mode": "fixed",
                                    "fixedColor": "#28594F"
                                }
                            }
                        ]
                    }
                ]
            }
        },
        {
            "id": 14,
            "type": "row",
            "title": "Airflow",
            "collapsed": false,
            "gridPos": {
                "x": 0,
                "y": 42,
                "w": 24,
                "h": 1
            },
            "panels": []
        },
        {
            "id": 15,
            "type": "timeseries",
            "title": "Task Transitions (SUCCESS vs FAILED)",
            "description": "Airflow task outcomes derived from Airflow 3.x supervisor Docker logs. Each Task finished event is counted once when final_state is success or failed; skipped states are excluded. The dag and filename label filters select the Docker log stream instead of the file-scraped task-log stream, preventing duplicate counting. A zero in a bucket means no matching transition in that bucket and is not a health check for Loki ingestion. Exact log strings depend on the upstream Airflow 3.x message format; if they shift in a future version, update the LogQL filters.",
            "gridPos": {
                "x": 6,
                "y": 43,
                "w": 18,
                "h": 8
            },
            "datasource": {
                "type": "loki",
                "uid": "loki"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "loki",
                        "uid": "loki"
                    },
                    "expr": "sum(count_over_time({service=\"urbangreen-airflow\",dag=\"\",filename=\"\"} |= \"Task finished\" |~ \"(?i)final_state=success\\\\b\" [$__interval]))",
                    "queryType": "range",
                    "legendFormat": "SUCCESS"
                },
                {
                    "refId": "B",
                    "datasource": {
                        "type": "loki",
                        "uid": "loki"
                    },
                    "expr": "sum(count_over_time({service=\"urbangreen-airflow\",dag=\"\",filename=\"\"} |= \"Task finished\" |~ \"(?i)final_state=failed\\\\b\" [$__interval]))",
                    "queryType": "range",
                    "legendFormat": "FAILED"
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "bottom",
                    "calcs": [
                        "lastNotNull",
                        "max"
                    ]
                },
                "tooltip": {
                    "mode": "multi"
                }
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "min": 0,
                    "noValue": "0",
                    "custom": {
                        "drawStyle": "bars",
                        "lineWidth": 1,
                        "fillOpacity": 65,
                        "spanNulls": false
                    }
                },
                "overrides": [
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "SUCCESS"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "mode": "fixed",
                                    "fixedColor": "#4CBB8A"
                                }
                            }
                        ]
                    },
                    {
                        "matcher": {
