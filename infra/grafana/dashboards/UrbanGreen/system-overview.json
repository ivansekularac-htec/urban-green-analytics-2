            "targets": [
                {
                    "editorMode": "code",
                    "expr": "sort(min by (job) (up))",
                    "format": "table",
                    "instant": true,
                    "legendFormat": "{{job}}",
                    "range": false,
                    "refId": "A"
                }
            ],
            "title": "Service Health",
            "transformations": [
                {
                    "id": "organize",
                    "options": {
                        "excludeByName": {
                            "Time": true
                        },
                        "indexByName": {
                            "job": 0,
                            "Value": 1
                        },
                        "renameByName": {
                            "job": "Service",
                            "Value": "Status"
                        }
                    }
                }
            ],
            "type": "table"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "description": "Number of Prometheus UP/DOWN transitions per job during the selected time range. Higher values indicate instability.",
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "decimals": 0,
                    "min": 0,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "#73BF69",
                                "value": null
                            },
                            {
                                "color": "#FF9830",
                                "value": 1
                            },
                            {
                                "color": "#F2495C",
                                "value": 3
                            }
                        ]
                    },
                    "unit": "short"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 12,
                "w": 15,
                "x": 9,
                "y": 0
            },
            "id": 2,
            "options": {
                "displayMode": "basic",
                "orientation": "horizontal",
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "showUnfilled": true
            },
            "targets": [
                {
                    "editorMode": "code",
                    "expr": "sort_desc(sum by (job) (changes(up[$__range])))",
