                                    "mode": "absolute",
                                    "steps": [
                                        {
                                            "color": "#F2495C",
                                            "value": null
                                        },
                                        {
                                            "color": "#73BF69",
                                            "value": 1
                                        }
                                    ]
                                }
                            },
                            {
                                "id": "custom.cellOptions",
                                "value": {
                                    "type": "color-background"
                                }
                            },
                            {
                                "id": "custom.align",
                                "value": "center"
                            },
                            {
                                "id": "custom.width",
                                "value": 120
                            }
                        ]
                    }
                ]
            },
            "gridPos": {
